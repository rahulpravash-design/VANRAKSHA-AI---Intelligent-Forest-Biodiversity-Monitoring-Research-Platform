# ============================================================================
# VANRAKSHA AI — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# ---------------------------------------------------------------- application
VANRAKSHA_ENV=development              # development | test | production
APP_NAME="VANRAKSHA AI"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------- database
# Postgres + PostGIS (docker-compose default). The backend also runs on SQLite
# for local development and the test suite.
DATABASE_URL=postgresql+psycopg://vanraksha:vanraksha@localhost:5432/vanraksha
# DATABASE_URL=sqlite:///./vanraksha.db
DB_ECHO=false

# ----------------------------------------------------------------- security
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-in-production-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=10
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Simple in-process rate limiting for auth endpoints
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------- first admin
# Used only by scripts/bootstrap_admin.py — never during public registration.
BOOTSTRAP_ADMIN_EMAIL=admin@vanraksha.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_NAME=VANRAKSHA Administrator

# -------------------------------------------------------------------- storage
# local | s3 . Object storage is used in production for images/audio.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
MAX_IMAGE_UPLOAD_MB=15
MAX_AUDIO_UPLOAD_MB=25
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_AUDIO_EXTENSIONS=.wav,.flac,.ogg,.mp3
# S3 / MinIO (only when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=vanraksha-media
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ AI engine
# When AI_SERVICE_URL is set the backend calls the AI microservice over HTTP;
# otherwise it imports the `ai` package in-process.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_SECONDS=30
AI_VISION_BACKEND=auto                 # auto | ultralytics | baseline
AI_AUDIO_BACKEND=auto                  # auto | torch | baseline
AI_VISION_WEIGHTS=
AI_AUDIO_WEIGHTS=
# Below this confidence a prediction is reported as UNCERTAIN instead of a species
AI_MIN_CONFIDENCE=0.45
AI_UNCERTAIN_MARGIN=0.08

# ----------------------------------------------------- biodiversity privacy
# Coordinates of sensitive species are generalised for low-privilege roles.
SENSITIVE_LOCATION_PRECISION_DEG=0.1   # ~11 km grid
PUBLIC_LOCATION_PRECISION_DEG=0.01     # ~1.1 km grid for anonymous access

# ------------------------------------------------------- anomaly detection
ANOMALY_BASELINE_DAYS=90
ANOMALY_WINDOW_DAYS=7
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_CONTAMINATION=0.08

# ------------------------------------------------------------------ frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
NEXT_PUBLIC_DEFAULT_MAP_CENTER=11.4102,76.6950
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=10
NEXT_PUBLIC_ENABLE_3D=true
